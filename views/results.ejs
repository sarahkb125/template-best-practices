<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Validation Results - <%= templateData.name %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="container">
    <header>
      <h1>Validation Results</h1>
      <a href="/" class="btn btn-secondary">Validate Another</a>
    </header>

    <main>
      <div class="card template-info">
        <h2><%= templateData.name %></h2>
        <% if (templateData.description) { %>
          <p class="template-description"><%= templateData.description %></p>
        <% } %>
        <div class="template-meta">
          <span class="meta-item">Code: <code><%= templateData.code %></code></span>
          <% if (templateData.creator) { %>
            <span class="meta-item">Creator: <%= templateData.creator.name %></span>
          <% } %>
          <% if (templateData.repoUrl && templateData.repoUrl !== 'N/A' && templateData.repoUrl.startsWith('http')) { %>
            <span class="meta-item">
              <a href="<%= templateData.repoUrl %>" target="_blank">View Repository</a>
            </span>
          <% } %>
        </div>
      </div>

      <div class="card score-card">
        <div class="score-header">
          <h2>Overall Score</h2>
          <div class="score <%= report.overallScore >= 80 ? 'score-good' : report.overallScore >= 50 ? 'score-medium' : 'score-bad' %>">
            <%= report.overallScore %>%
          </div>
        </div>
        <div class="score-stats">
          <div class="stat">
            <div class="stat-value"><%= report.passedRules %></div>
            <div class="stat-label">Passed</div>
          </div>
          <div class="stat">
            <div class="stat-value"><%= report.failedRules %></div>
            <div class="stat-label">Failed</div>
          </div>
          <div class="stat">
            <div class="stat-value"><%= report.warnings %></div>
            <div class="stat-label">Warnings</div>
          </div>
        </div>
      </div>

      <div class="results-section">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
          <h2 style="margin: 0;">Validation Details</h2>
          <button onclick="toggleAll()" class="btn btn-secondary" id="toggle-all-btn">Expand All</button>
        </div>

        <%
        const groupedResults = {};
        const technicalRules = new Set(['env-vars', 'health-checks', 'authentication', 'private-networking', 'persistent-storage']);
        const visualResults = {};
        const technicalResults = {};

        report.results.forEach(result => {
          if (!groupedResults[result.rule.id]) {
            groupedResults[result.rule.id] = [];
          }
          groupedResults[result.rule.id].push(result);
        });

        // Separate into visual and technical sections
        Object.entries(groupedResults).forEach(([ruleId, results]) => {
          if (technicalRules.has(ruleId)) {
            technicalResults[ruleId] = results;
          } else {
            visualResults[ruleId] = results;
          }
        });
        %>

        <!-- Visual Checks -->
        <div class="section-group">
          <h3 class="section-title">Visual Checks</h3>

          <% Object.entries(visualResults).forEach(([ruleId, results]) => {
            const ruleResults = results;
            const allPassed = ruleResults.every(r => r.passed);
            const hasErrors = ruleResults.some(r => !r.passed && r.severity === 'error');
            const hasWarnings = ruleResults.some(r => !r.passed && r.severity === 'warning');

            // Calculate counts for summary
            const passedCount = ruleResults.filter(r => r.passed).length;
            const errorCount = ruleResults.filter(r => !r.passed && r.severity === 'error').length;
            const warningCount = ruleResults.filter(r => !r.passed && r.severity === 'warning').length;
            const cardId = ruleId + '-card';
          %>
            <div class="result-card <%= allPassed ? 'result-pass' : hasErrors ? 'result-error' : 'result-warning' %>">
              <div class="result-header result-toggle" onclick="toggleCard('<%= cardId %>')">
                <div>
                  <span class="result-icon"><%= allPassed ? '✓' : hasErrors ? '✗' : '⚠' %></span>
                  <h3><%= ruleResults[0].rule.name %></h3>
                  <span class="result-summary" id="<%= cardId %>-summary">
                    <% if (passedCount > 0) { %><span class="summary-success"><%= passedCount %> passed</span><% } %>
                    <% if (errorCount > 0) { %><span class="summary-error"><%= errorCount %> failed</span><% } %>
                    <% if (warningCount > 0) { %><span class="summary-warning"><%= warningCount %> warning<%= warningCount > 1 ? 's' : '' %></span><% } %>
                  </span>
                </div>
                <div>
                  <span class="toggle-icon" id="<%= cardId %>-icon">▼</span>
                </div>
              </div>

              <div class="result-content collapsed" id="<%= cardId %>-content">
                <p class="rule-description"><%= ruleResults[0].rule.description %></p>

                <% ruleResults.forEach(result => { %>
                  <div class="result-item">
                    <p class="result-message"><%= result.message %></p>

                    <% if (result.suggestions && result.suggestions.length > 0) { %>
                      <div class="suggestions">
                        <strong>Suggestions:</strong>
                        <ul>
                          <% result.suggestions.forEach(suggestion => { %>
                            <li><%= suggestion %></li>
                          <% }) %>
                        </ul>
                      </div>
                    <% } %>
                  </div>
                <% }) %>
              </div>
            </div>
          <% }) %>
        </div>

        <!-- Technical Checks -->
        <% if (Object.keys(technicalResults).length > 0) { %>
        <div class="section-group">
          <h3 class="section-title">Technical Checks</h3>
          <p class="section-description">Environment variables, health checks, authentication, networking, and storage configuration</p>

          <% Object.entries(technicalResults).forEach(([ruleId, results]) => {
            const ruleResults = results;
            const allPassed = ruleResults.every(r => r.passed);
            const hasErrors = ruleResults.some(r => !r.passed && r.severity === 'error');
            const hasWarnings = ruleResults.some(r => !r.passed && r.severity === 'warning');

            // Calculate counts for summary
            const passedCount = ruleResults.filter(r => r.passed).length;
            const errorCount = ruleResults.filter(r => !r.passed && r.severity === 'error').length;
            const warningCount = ruleResults.filter(r => !r.passed && r.severity === 'warning').length;
            const cardId = ruleId + '-card';
          %>
            <div class="result-card <%= allPassed ? 'result-pass' : hasErrors ? 'result-error' : 'result-warning' %>">
              <div class="result-header result-toggle" onclick="toggleCard('<%= cardId %>')">
                <div>
                  <span class="result-icon"><%= allPassed ? '✓' : hasErrors ? '✗' : '⚠' %></span>
                  <h3><%= ruleResults[0].rule.name %></h3>
                  <span class="result-summary" id="<%= cardId %>-summary">
                    <% if (passedCount > 0) { %><span class="summary-success"><%= passedCount %> passed</span><% } %>
                    <% if (errorCount > 0) { %><span class="summary-error"><%= errorCount %> failed</span><% } %>
                    <% if (warningCount > 0) { %><span class="summary-warning"><%= warningCount %> warning<%= warningCount > 1 ? 's' : '' %></span><% } %>
                  </span>
                </div>
                <div>
                  <span class="toggle-icon" id="<%= cardId %>-icon">▼</span>
                </div>
              </div>

              <div class="result-content collapsed" id="<%= cardId %>-content">
                <p class="rule-description"><%= ruleResults[0].rule.description %></p>

                <% ruleResults.forEach(result => { %>
                  <div class="result-item">
                    <p class="result-message"><%= result.message %></p>

                    <% if (result.suggestions && result.suggestions.length > 0) { %>
                      <div class="suggestions">
                        <strong>Suggestions:</strong>
                        <ul>
                          <% result.suggestions.forEach(suggestion => { %>
                            <li><%= suggestion %></li>
                          <% }) %>
                        </ul>
                      </div>
                    <% } %>
                  </div>
                <% }) %>
              </div>
            </div>
          <% }) %>
        </div>
        <% } %>
      </div>
    </main>

    <footer>
      <p>Built for Railway • <a href="/" class="btn btn-link">Validate Another Template</a></p>
    </footer>
  </div>

  <script>
    let allExpanded = false;

    // Initialize summaries on page load
    document.addEventListener('DOMContentLoaded', function() {
      const summaries = document.querySelectorAll('.result-summary');
      summaries.forEach(summary => {
        summary.style.display = 'inline-flex';
      });
    });

    function toggleCard(cardId) {
      const content = document.getElementById(cardId + '-content');
      const icon = document.getElementById(cardId + '-icon');
      const summary = document.getElementById(cardId + '-summary');

      if (content.classList.contains('collapsed')) {
        content.classList.remove('collapsed');
        icon.textContent = '▲';
        summary.style.display = 'none';
      } else {
        content.classList.add('collapsed');
        icon.textContent = '▼';
        summary.style.display = 'inline-flex';
      }

      // Update toggle all button state
      updateToggleAllButton();
    }

    function toggleAll() {
      const allContents = document.querySelectorAll('.result-content');
      const allIcons = document.querySelectorAll('.result-header .toggle-icon');
      const allSummaries = document.querySelectorAll('.result-summary');

      allExpanded = !allExpanded;

      allContents.forEach(content => {
        if (allExpanded) {
          content.classList.remove('collapsed');
        } else {
          content.classList.add('collapsed');
        }
      });

      allIcons.forEach(icon => {
        icon.textContent = allExpanded ? '▲' : '▼';
      });

      allSummaries.forEach(summary => {
        summary.style.display = allExpanded ? 'none' : 'inline-flex';
      });

      updateToggleAllButton();
    }

    function updateToggleAllButton() {
      const btn = document.getElementById('toggle-all-btn');
      const allContents = document.querySelectorAll('.result-content');
      const expandedCount = Array.from(allContents).filter(c => !c.classList.contains('collapsed')).length;

      allExpanded = expandedCount === allContents.length;
      btn.textContent = allExpanded ? 'Collapse All' : 'Expand All';
    }
  </script>
</body>
</html>
